---
import { BASE, T, LANGS, urlInici, numSetmana } from '../lib/i18n.js';
import { setmanes } from '../lib/dades.js';
const abs = (p) => new URL(p, Astro.site).toString();
const ultima = setmanes()[0];
const descripcio = ultima ? ultima.items.slice(0, 3).map((i) => i.title.en).join(' · ') : T.en.aboutText[0];
const titol = ultima ? `AI Weekly · ${T.en.setmana(numSetmana(ultima.week))}` : 'AI Weekly — keep up with it';
const imatge = abs(ultima ? `${BASE}/og/en/${ultima.week}.png` : `${BASE}/og/default.png`);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{ultima ? titol : 'AI Weekly'}</title>
<meta name="description" content={descripcio} />
<link rel="canonical" href={abs(`${BASE}/`)} />
{LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(urlInici(l))} />)}
<link rel="alternate" hreflang="x-default" href={abs(urlInici('en'))} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI Weekly" />
<meta property="og:title" content={titol} />
<meta property="og:description" content={descripcio} />
<meta property="og:url" content={abs(`${BASE}/`)} />
<meta property="og:image" content={imatge} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ultima ? descripcio : 'AI Weekly'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={imatge} />
<script>
  import { idiomaPreferit, BASE } from '../lib/i18n.js';
  const llengues = navigator.languages?.length ? navigator.languages : [navigator.language];
  location.replace(`${BASE}/${idiomaPreferit(llengues)}/`);
</script></head>
<body><noscript><a href={`${BASE}/ca/`}>Català</a> · <a href={`${BASE}/es/`}>Español</a> · <a href={`${BASE}/en/`}>English</a></noscript></body></html>
