---
import Base from '../layouts/Base.astro';
import Capcalera from './Capcalera.astro';
import Setmana from './Setmana.astro';
import Peu from './Peu.astro';
const { lang, setmanes, oberta, title, description, ogImage, ogAlt, url, alternates } = Astro.props;
---
<Base {lang} {title} {description} {ogImage} {ogAlt} {url} {alternates}>
  <main class="pagina">
    <Capcalera {lang} {alternates} />
    <slot name="cronologia" />
    <div id="setmanes">
      {setmanes.map((s) => <Setmana setmana={s} {lang} oberta={s.week === oberta} />)}
    </div>
    <Peu {lang} />
  </main>
</Base>
