---
import { mapaCalor } from '../lib/mapa.js';
import { CATEGORIES } from '../lib/dades.js';
import { T, urlSetmana } from '../lib/i18n.js';
// propia: a la permanent d'una setmana, les caselles de les ALTRES setmanes enllacen a la seva permanent (aquí no hi tenen cos).
const { setmanes, empreses, lang, propia } = Astro.props;
const href = (week) => (propia && week !== propia ? urlSetmana(lang, week) : `#s-${week}`);
const t = T[lang];
const m = mapaCalor(setmanes, empreses, lang);
const n = m.columnes.length;
const F = m.files.length;
---
{F > 0 && (
<section class="caixa mapa" data-setmanes={JSON.stringify(m.columnes.map((c) => c.week))}
  >
  <div class="mapa-cap">
    <h2 class="h"><span><span aria-hidden="true">🚀</span> {t.quiHaTret}</span></h2>
    <div class="llegenda" aria-hidden="true">{['0', '1', '2', '3+'].map((x, i) => <span><i class={`q n${i}`}></i>{x}</span>)}</div>
  </div>
  <div class="cats" role="group" aria-label={t.categories}>
    {CATEGORIES.map((c) => <button class="cat-btn" type="button" data-cat={c} aria-pressed="false">{t.cats[c]}</button>)}
  </div>
  <div class="mapa-scroll">
    <div class="graella" style={`--n:${n}`}>
      {m.files.map((f, fi) => (
        <>
          <button class="empresa" type="button" data-co={f.name} aria-pressed="false" style={`grid-row:${fi + 1}`}>{f.name}</button>
          {f.caselles.map((c) => (
            <a class={`casella n${c.nivell}`} href={href(c.week)} aria-label={c.aria} data-week={c.week} data-idx={c.idx}
               data-co={f.name} data-t={m.columnes[c.idx].etiqueta} data-ts={JSON.stringify(c.titols)}
               style={`grid-row:${fi + 1};grid-column:${c.idx + 2}`}></a>
          ))}
        </>
      ))}
      <span class="nom-buit" style={`grid-row:${F + 1}`}></span>
      {m.mesos.map((x) => <span class="mes-mapa" style={`grid-row:${F + 1};grid-column:${x.inici + 2} / span ${x.span}`}>{x.etiqueta}</span>)}
    </div>
  </div>
</section>
)}
