---
import { T, LANGS, urlInici } from '../lib/i18n.js';
const { lang, alternates, logoNoEsTitol } = Astro.props;  // alternates: {lang, url}[]
// El logo és el h1 de la pàgina, llevat d'on la pàgina ja en té un de propi (Com es fa).
const Logo = logoNoEsTitol ? 'p' : 'h1';
---
<header class="dalt">
  <div>
    <Logo class="logo"><a href={urlInici(lang)}>AI<br />WEEKLY</a></Logo>
    <div class="tag">{T[lang].tagline}</div>
  </div>
  <nav class="botons">
    {LANGS.map((l) => {
      const a = alternates.find((x) => x.lang === l);
      return <a class="btn" href={a.url} hreflang={l} aria-current={l === lang ? 'true' : 'false'}>{l.toUpperCase()}</a>;
    })}
    <a class="btn" href="https://github.com/jrbayguade/ai-weekly">★ GitHub</a>
  </nav>
</header>
